{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orchestrator-engine://schemas/followup-signal",
  "title": "Provider-neutral terminal follow-up signal",
  "schema_version": 1,
  "kind": "ORCHESTRATOR_FOLLOWUP_SIGNAL",
  "type": "object",
  "required": ["schema_version", "kind", "event_id", "project_id", "source_kind", "operation_id", "event_path", "terminal_status", "result_path", "evidence_path", "created_at", "requires"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "ORCHESTRATOR_FOLLOWUP_SIGNAL"},
    "event_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "project_id": {"type": "string", "minLength": 1},
    "source_kind": {"type": "string", "minLength": 1},
    "operation_id": {"type": "string", "minLength": 1},
    "event_path": {"type": "string", "pattern": "^/"},
    "terminal_status": {"enum": ["completed", "failed", "cancelled", "timed_out", "action_required", "unavailable", "ambiguous"]},
    "result_path": {"type": "string", "pattern": "^/"},
    "evidence_path": {"type": "string", "pattern": "^/"},
    "created_at": {"type": "string", "format": "date-time"},
    "not_before": {"type": "string", "format": "date-time"},
    "requires": {"const": "ORCHESTRATOR_FOLLOWUP"},
    "wake_target": {"$ref": "orchestrator-engine://schemas/wake-target"}
  },
  "additionalProperties": true
}
