{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orchestrator-engine://schemas/workstream",
  "title": "Bounded agent workstream",
  "schema_version": 1,
  "kind": "ORCHESTRATOR_WORKSTREAM",
  "type": "object",
  "required": ["schema_version", "kind", "workstream_id", "project_id", "goal", "status", "continuation_count", "max_continuations", "delay_seconds", "max_wall_seconds", "created_at", "updated_at"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "ORCHESTRATOR_WORKSTREAM"},
    "workstream_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "project_id": {"type": "string", "minLength": 1},
    "goal": {"type": "string", "minLength": 1, "maxLength": 4000},
    "status": {"enum": ["active", "waiting_external", "needs_user", "blocked", "complete", "paused"]},
    "continuation_count": {"type": "integer", "minimum": 0},
    "max_continuations": {"type": "integer", "minimum": 1, "maximum": 100},
    "delay_seconds": {"type": "number", "minimum": 0, "maximum": 3600},
    "max_wall_seconds": {"type": "integer", "minimum": 1, "maximum": 604800},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "wake_target": {"$ref": "orchestrator-engine://schemas/wake-target"}
  },
  "additionalProperties": true
}
