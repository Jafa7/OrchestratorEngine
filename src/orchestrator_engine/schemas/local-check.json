{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orchestrator-engine://schemas/local-check",
  "title": "First-class local check descriptor",
  "schema_version": 1,
  "kind": "ORCHESTRATOR_LOCAL_CHECK",
  "type": "object",
  "required": ["schema_version", "kind", "check_id", "suite", "verification", "fingerprint", "status", "execution", "requested_execution", "wake_policy", "requested_wake_policy", "long_threshold_seconds", "plan", "created_at", "check_dir"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "ORCHESTRATOR_LOCAL_CHECK"},
    "check_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "suite": {"type": "string", "minLength": 1},
    "verification": {"enum": ["structural", "focused", "full"]},
    "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"enum": ["starting", "running", "passed", "failed", "errored", "cancelled"]},
    "execution": {"enum": ["foreground", "detached"]},
    "requested_execution": {"enum": ["auto", "foreground", "detached"]},
    "wake_policy": {"enum": ["always", "on-failure", "never"]},
    "requested_wake_policy": {"enum": ["auto", "always", "on-failure", "never"]},
    "long_threshold_seconds": {"type": "number", "exclusiveMinimum": 0},
    "plan": {"type": "object"},
    "created_at": {"type": "string", "format": "date-time"},
    "check_dir": {"type": "string", "pattern": "^/"},
    "wake_target": {"$ref": "orchestrator-engine://schemas/wake-target"},
    "supervisor_pid": {"type": "integer", "minimum": 1},
    "supervisor_identity": {"type": "object"},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "duration_seconds": {"type": "number", "minimum": 0},
    "result_path": {"type": "string", "pattern": "^/"},
    "summary_path": {"type": "string", "pattern": "^/"},
    "evidence_path": {"type": "string", "pattern": "^/"},
    "event_id": {"type": "string", "minLength": 1},
    "event_path": {"type": "string", "pattern": "^/"},
    "signal_path": {"type": ["string", "null"]},
    "recovered_at": {"type": "string", "format": "date-time"},
    "error": {"type": "string", "maxLength": 1000}
  },
  "additionalProperties": true
}
