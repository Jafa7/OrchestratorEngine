{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orchestrator-engine://schemas/github-pr-evidence",
  "title": "GitHub pull request readiness evidence",
  "schema_version": 1,
  "kind": "GITHUB_PR_READINESS_EVIDENCE",
  "type": "object",
  "required": ["schema_version", "kind", "monitor_id", "source_kind", "hostname", "repository", "pr_number", "expected_head_sha", "review_policy", "monitor_status", "sample_count", "started_at", "finished_at", "duration_seconds", "summary", "result_path", "summary_path"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "GITHUB_PR_READINESS_EVIDENCE"},
    "monitor_id": {"type": "string", "minLength": 1},
    "source_kind": {"const": "github_pull_request"},
    "hostname": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
    "pr_number": {"type": "integer", "minimum": 1},
    "expected_head_sha": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "review_policy": {"enum": ["ignore", "approved"]},
    "monitor_status": {"enum": ["ready", "merged", "failed_checks", "changes_requested", "conflicting", "head_changed", "closed", "cancelled", "timed_out", "unavailable", "ambiguous", "failed"]},
    "failure_kind": {"type": ["string", "null"]},
    "snapshot": {"type": ["object", "null"]},
    "command_evidence": {"type": ["object", "null"]},
    "sample_count": {"type": "integer", "minimum": 0},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "duration_seconds": {"type": "number", "minimum": 0},
    "summary": {"type": "string", "maxLength": 1000},
    "result_path": {"type": "string", "pattern": "^/"},
    "summary_path": {"type": "string", "pattern": "^/"},
    "error": {"type": "string", "maxLength": 1000},
    "wake_target": {"$ref": "orchestrator-engine://schemas/wake-target"}
  },
  "additionalProperties": true
}
