{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orchestrator-engine://schemas/continuity-activation-evidence",
  "title": "Transactional continuity activation evidence",
  "schema_version": 1,
  "kind": "ORCHESTRATOR_CONTINUITY_ACTIVATION_EVIDENCE",
  "type": "object",
  "required": ["schema_version", "kind", "activation_id", "control_epoch", "endpoint_generation", "created_at"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "ORCHESTRATOR_CONTINUITY_ACTIVATION_EVIDENCE"},
    "activation_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "control_epoch": {"type": "integer", "minimum": 1},
    "endpoint_generation": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
