{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orchestrator-engine://schemas/metrics-progress",
  "title": "Metrics scope progress",
  "schema_version": 1,
  "kind": "ORCHESTRATOR_METRICS_PROGRESS",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "generation_digest",
    "registry_digest",
    "evaluation_time",
    "registry_project_uuid",
    "module_id",
    "minimum_forecast_samples",
    "authority",
    "status",
    "reason",
    "baseline_revision",
    "current_revision",
    "baseline",
    "current",
    "scope_change",
    "modules",
    "forecast",
    "details"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "ORCHESTRATOR_METRICS_PROGRESS"},
    "generation_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "registry_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evaluation_time": {"type": "string", "format": "date-time"},
    "registry_project_uuid": {"type": "string", "format": "uuid"},
    "module_id": {"type": ["string", "null"]},
    "minimum_forecast_samples": {"type": "integer", "minimum": 1},
    "authority": {"const": "advisory_only"},
    "status": {"enum": ["available", "partial", "unavailable"]},
    "reason": {"type": "string", "minLength": 1},
    "baseline_revision": {"type": ["string", "null"]},
    "current_revision": {"type": ["string", "null"]},
    "baseline": {"type": ["object", "null"]},
    "current": {"type": ["object", "null"]},
    "scope_change": {"type": ["object", "null"]},
    "modules": {"type": "array", "items": {"type": "object"}},
    "forecast": {"type": "object"},
    "details": {"type": "object"}
  },
  "additionalProperties": false
}
