{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orchestrator-engine://schemas/operation-applicability-declaration",
  "title": "Producer-owned operation applicability declaration",
  "schema_version": 1,
  "kind": "ORCHESTRATOR_OPERATION_APPLICABILITY_DECLARATION",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "project", "work", "revision", "candidate", "criteria", "retry_of"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "ORCHESTRATOR_OPERATION_APPLICABILITY_DECLARATION"},
    "project": {"$ref": "#/$defs/opaqueId"},
    "work": {"$ref": "#/$defs/opaqueId"},
    "revision": {"$ref": "#/$defs/opaqueId"},
    "candidate": {"$ref": "#/$defs/opaqueId"},
    "criteria": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "revision"],
        "properties": {"id": {"$ref": "#/$defs/opaqueId"}, "revision": {"$ref": "#/$defs/opaqueId"}}
      }
    },
    "retry_of": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/retry"}]}
  },
  "$defs": {
    "opaqueId": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "retry": {
      "type": "object", "additionalProperties": false,
      "required": ["operation_kind", "operation_id", "attempt_id", "applicability_sha256", "source_namespace", "native_location_binding"],
      "properties": {
        "operation_kind": {"const": "check"},
        "operation_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
        "attempt_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
        "applicability_sha256": {"$ref": "#/$defs/digest"},
        "source_namespace": {"$ref": "#/$defs/digest"},
        "native_location_binding": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
