{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orchestrator-engine://schemas/local-check-evidence",
  "title": "First-class local check evidence",
  "schema_version": 1,
  "kind": "ORCHESTRATOR_LOCAL_CHECK_EVIDENCE",
  "type": "object",
  "required": ["schema_version", "kind", "check_id", "suite", "fingerprint", "execution", "wake_policy", "plan", "result_path", "result_sha256", "summary_path", "summary_sha256", "recorded_at"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "ORCHESTRATOR_LOCAL_CHECK_EVIDENCE"},
    "check_id": {"type": "string", "minLength": 1},
    "suite": {"type": "string", "minLength": 1},
    "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "execution": {"enum": ["foreground", "detached"]},
    "wake_policy": {"enum": ["always", "on-failure", "never"]},
    "plan": {"type": "object"},
    "result_path": {"type": "string", "pattern": "^/"},
    "result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "summary_path": {"type": "string", "pattern": "^/"},
    "summary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "full_log_path": {"type": "string", "pattern": "^/"},
    "full_log_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "error": {"type": "string", "maxLength": 1000},
    "applicability": {"$ref": "#/$defs/applicabilityMetadata"},
    "wake_target": {"$ref": "orchestrator-engine://schemas/wake-target"}
  },
  "additionalProperties": false,
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "applicabilityMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer_version", "attempt_id", "artifact_path", "artifact_sha256", "input_path", "input_raw_sha256", "declaration_sha256", "request_fingerprint", "source_namespace", "native_location_binding", "suite_fingerprint"],
      "properties": {
        "producer_version": {"const": 1},
        "attempt_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
        "artifact_path": {"const": "applicability.json"},
        "artifact_sha256": {"$ref": "#/$defs/digest"},
        "input_path": {"const": "applicability-input.json"},
        "input_raw_sha256": {"$ref": "#/$defs/digest"},
        "declaration_sha256": {"$ref": "#/$defs/digest"},
        "request_fingerprint": {"$ref": "#/$defs/digest"},
        "source_namespace": {"$ref": "#/$defs/digest"},
        "native_location_binding": {"$ref": "#/$defs/digest"},
        "suite_fingerprint": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
