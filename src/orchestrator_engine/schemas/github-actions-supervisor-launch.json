{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orchestrator-engine://schemas/github-actions-supervisor-launch",
  "title": "GitHub Actions monitor supervisor launch record",
  "schema_version": 1,
  "kind": "GITHUB_ACTIONS_MONITOR_SUPERVISOR_LAUNCH",
  "type": "object",
  "required": ["schema_version", "kind", "monitor_id", "supervisor_pid", "launched_at"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "GITHUB_ACTIONS_MONITOR_SUPERVISOR_LAUNCH"},
    "monitor_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "supervisor_pid": {"type": "integer", "minimum": 1},
    "supervisor_identity": {"type": "object"},
    "launched_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": true
}
