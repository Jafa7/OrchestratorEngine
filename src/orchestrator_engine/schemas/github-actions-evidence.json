{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orchestrator-engine://schemas/github-actions-evidence",
  "title": "GitHub Actions monitor evidence",
  "schema_version": 1,
  "kind": "GITHUB_ACTIONS_MONITOR_EVIDENCE",
  "type": "object",
  "required": ["schema_version", "kind", "monitor_id", "source_kind", "hostname", "repository", "run_id", "monitor_status", "started_at", "finished_at", "duration_seconds", "summary", "result_path", "summary_path", "log_path"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "GITHUB_ACTIONS_MONITOR_EVIDENCE"},
    "monitor_id": {"type": "string", "minLength": 1},
    "source_kind": {"const": "github_actions"},
    "hostname": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "minLength": 3},
    "run_id": {"type": ["integer", "null"], "minimum": 1},
    "monitor_status": {"enum": ["completed", "failed", "cancelled", "timed_out", "unavailable", "ambiguous"]},
    "ci_conclusion": {"type": ["string", "null"]},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "duration_seconds": {"type": "number", "minimum": 0},
    "failure_kind": {"type": ["string", "null"]},
    "discovery": {
      "type": "object",
      "required": ["status", "query_count", "duration_seconds"],
      "properties": {
        "status": {"enum": ["resolved", "cancelled", "timed_out", "unavailable", "ambiguous"]},
        "run_id": {"type": "integer", "minimum": 1},
        "workflow_name": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
        "query_count": {"type": "integer", "minimum": 0},
        "candidate_count": {"type": "integer", "minimum": 0},
        "duration_seconds": {"type": "number", "minimum": 0},
        "failure_kind": {"type": "string", "minLength": 1},
        "active_monitor_id": {"type": "string", "minLength": 1},
        "last_query": {"type": ["object", "null"]}
      },
      "allOf": [
        {
          "if": {
            "required": ["status"],
            "properties": {"status": {"const": "resolved"}}
          },
          "then": {"required": ["run_id", "candidate_count"]}
        }
      ],
      "additionalProperties": true
    },
    "error": {"type": "string", "maxLength": 1000},
    "initial_view": {"type": ["object", "null"]},
    "watch": {"type": ["object", "null"]},
    "final_view": {"type": ["object", "null"]},
    "failure_diagnostics": {
      "type": "object",
      "required": ["status", "command"],
      "properties": {
        "status": {"enum": ["available", "unavailable"]},
        "failure_kind": {"type": "string", "minLength": 1},
        "job_count": {"type": "integer", "minimum": 0},
        "problem_job_count": {"type": "integer", "minimum": 0},
        "problem_step_count": {"type": "integer", "minimum": 0},
        "truncated": {"type": "boolean"},
        "problem_jobs": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": ["name", "status", "conclusion", "problem_steps"],
            "properties": {
              "name": {"type": "string", "minLength": 1, "maxLength": 256},
              "status": {"type": ["string", "null"], "maxLength": 256},
              "conclusion": {"enum": ["action_required", "cancelled", "failure", "startup_failure", "timed_out"]},
              "database_id": {"type": "integer", "minimum": 1},
              "problem_steps": {
                "type": "array",
                "maxItems": 50,
                "items": {
                  "type": "object",
                  "required": ["name", "status", "conclusion"],
                  "properties": {
                    "name": {"type": "string", "minLength": 1, "maxLength": 256},
                    "status": {"type": ["string", "null"], "maxLength": 256},
                    "conclusion": {"enum": ["action_required", "cancelled", "failure", "startup_failure", "timed_out"]},
                    "number": {"type": "integer", "minimum": 1}
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "error": {"type": "string", "maxLength": 1000},
        "command": {"type": "object"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "available"}}},
          "then": {"required": ["job_count", "problem_job_count", "problem_step_count", "truncated", "problem_jobs"]},
          "else": {"required": ["failure_kind"]}
        }
      ],
      "additionalProperties": true
    },
    "recovery": {"type": "object"},
    "summary": {"type": "string", "maxLength": 1000},
    "result_path": {"type": "string", "pattern": "^/"},
    "summary_path": {"type": "string", "pattern": "^/"},
    "log_path": {"type": "string", "pattern": "^/"},
    "wake_target": {"$ref": "orchestrator-engine://schemas/wake-target"}
  },
  "allOf": [
    {
      "if": {
        "required": ["run_id"],
        "properties": {"run_id": {"type": "null"}}
      },
      "then": {"required": ["discovery"]}
    }
  ],
  "additionalProperties": true
}
