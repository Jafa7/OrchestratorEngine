{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orchestrator-engine://schemas/resource-queue",
  "title": "Project resource queue status",
  "schema_version": 1,
  "kind": "ORCHESTRATOR_RESOURCE_QUEUE",
  "type": "object",
  "required": ["schema_version", "kind", "authority", "stages", "terminal", "action_required"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "ORCHESTRATOR_RESOURCE_QUEUE"},
    "authority": {"type": "string", "minLength": 1},
    "terminal": {"type": "boolean"},
    "action_required": {"type": "boolean"},
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "request", "project", "name", "state", "allocation", "epoch"],
        "not": {
          "anyOf": [
            {"required": ["launch_token"]},
            {"required": ["maintenance_token"]}
          ]
        },
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "request": {"type": "string", "minLength": 1},
          "project": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "state": {"enum": ["waiting", "granted", "launching", "running", "cleanup", "recovery_required", "passed", "failed", "cancelled", "invalidated", "skipped"]},
          "epoch": {"type": "integer", "minimum": 0},
          "allocation": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["mode", "units", "compatibility"],
              "properties": {
                "mode": {"enum": ["exclusive", "shared"]},
                "units": {"type": "integer", "minimum": 1},
                "compatibility": {"type": ["string", "null"]}
              }
            }
          }
        }
      }
    }
  }
}
