{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orchestrator-engine://schemas/github-actions-monitor",
  "title": "GitHub Actions detached monitor descriptor",
  "schema_version": 1,
  "kind": "GITHUB_ACTIONS_MONITOR",
  "type": "object",
  "required": ["schema_version", "kind", "monitor_id", "source_kind", "status", "hostname", "repository", "run_id", "wake_policy", "monitor_dir", "created_at"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "GITHUB_ACTIONS_MONITOR"},
    "monitor_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "source_kind": {"const": "github_actions"},
    "status": {"enum": ["starting", "running", "completed", "failed", "cancelled", "timed_out", "unavailable", "ambiguous"]},
    "hostname": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
    "run_id": {"type": ["integer", "null"], "minimum": 1},
    "requested_run_id": {"type": ["integer", "null"], "minimum": 1},
    "attempt": {"type": ["integer", "null"], "minimum": 1},
    "expected_head_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{7,64}$"},
    "workflow_name": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
    "discovery": {
      "type": "object",
      "required": ["status", "query_count", "duration_seconds"],
      "properties": {
        "status": {"enum": ["resolved", "cancelled", "timed_out", "unavailable", "ambiguous"]},
        "run_id": {"type": "integer", "minimum": 1},
        "workflow_name": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
        "query_count": {"type": "integer", "minimum": 0},
        "candidate_count": {"type": "integer", "minimum": 0},
        "duration_seconds": {"type": "number", "minimum": 0},
        "failure_kind": {"type": "string", "minLength": 1},
        "active_monitor_id": {"type": "string", "minLength": 1},
        "last_query": {"type": ["object", "null"]}
      },
      "allOf": [
        {
          "if": {
            "required": ["status"],
            "properties": {"status": {"const": "resolved"}}
          },
          "then": {"required": ["run_id", "candidate_count"]}
        }
      ],
      "additionalProperties": true
    },
    "discovery_query_count": {"type": "integer", "minimum": 0},
    "wake_policy": {"enum": ["always", "on-failure", "action-required"]},
    "timeout_seconds": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "gh_command": {"type": "string", "minLength": 1, "maxLength": 4096},
    "supervisor_pid": {"type": "integer", "minimum": 1},
    "supervisor_identity": {"type": "object"},
    "watch_pid": {"type": "integer", "minimum": 1},
    "watch_pgid": {"type": "integer", "minimum": 1},
    "watch_identity": {"type": "object"},
    "retry_of": {"type": "string", "minLength": 1},
    "retry_reason": {"type": "string", "minLength": 1, "maxLength": 1000},
    "monitor_dir": {"type": "string", "pattern": "^/"},
    "supervisor_log": {"type": "string", "pattern": "^/"},
    "created_at": {"type": "string", "format": "date-time"},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "last_alive_at": {"type": "string", "format": "date-time"},
    "ci_conclusion": {"type": ["string", "null"]},
    "failure_kind": {"type": ["string", "null"]},
    "result_path": {"type": "string", "pattern": "^/"},
    "evidence_path": {"type": "string", "pattern": "^/"},
    "summary_path": {"type": "string", "pattern": "^/"},
    "event_path": {"type": "string", "pattern": "^/"},
    "signal_path": {"type": ["string", "null"], "pattern": "^/"},
    "signal_emitted": {"type": "boolean"},
    "wake_target": {"$ref": "orchestrator-engine://schemas/wake-target"}
  },
  "allOf": [
    {
      "if": {
        "required": ["run_id"],
        "properties": {"run_id": {"type": "null"}}
      },
      "then": {
        "required": ["requested_run_id", "expected_head_sha", "timeout_seconds"],
        "properties": {
          "requested_run_id": {"type": "null"},
          "attempt": {"type": "null"},
          "expected_head_sha": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
          "timeout_seconds": {"type": "number", "exclusiveMinimum": 0}
        }
      }
    },
    {
      "if": {
        "required": ["run_id"],
        "properties": {"run_id": {"type": "integer"}}
      },
      "then": {
        "properties": {"workflow_name": {"type": "null"}}
      }
    }
  ],
  "additionalProperties": true
}
