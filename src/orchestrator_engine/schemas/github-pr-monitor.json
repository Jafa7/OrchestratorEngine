{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orchestrator-engine://schemas/github-pr-monitor",
  "title": "GitHub pull request readiness monitor descriptor",
  "schema_version": 1,
  "kind": "GITHUB_PR_READINESS_MONITOR",
  "type": "object",
  "required": ["schema_version", "kind", "monitor_id", "source_kind", "status", "hostname", "repository", "pr_number", "expected_head_sha", "review_policy", "interval_seconds", "timeout_seconds", "wake_policy", "gh_command", "monitor_dir", "created_at"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "GITHUB_PR_READINESS_MONITOR"},
    "monitor_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "source_kind": {"const": "github_pull_request"},
    "status": {"enum": ["starting", "running", "ready", "merged", "failed_checks", "changes_requested", "conflicting", "head_changed", "closed", "cancelled", "timed_out", "unavailable", "ambiguous", "failed"]},
    "hostname": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
    "pr_number": {"type": "integer", "minimum": 1},
    "expected_head_sha": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "review_policy": {"enum": ["ignore", "approved"]},
    "interval_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 300},
    "timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 604800},
    "wake_policy": {"enum": ["always", "on-failure", "action-required"]},
    "gh_command": {"type": "string", "minLength": 1, "maxLength": 4096},
    "monitor_dir": {"type": "string", "pattern": "^/"},
    "supervisor_log": {"type": "string", "pattern": "^/"},
    "created_at": {"type": "string", "format": "date-time"},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "last_alive_at": {"type": "string", "format": "date-time"},
    "failure_kind": {"type": ["string", "null"]},
    "sample_count": {"type": "integer", "minimum": 0},
    "wake_target": {"$ref": "orchestrator-engine://schemas/wake-target"}
  },
  "additionalProperties": true
}
